APP_ENV=local
DISPLAY_ERRORS=true

# Main Database
DB_HOST=
DB_NAME=itcindo_itconenew
DB_USER=itcindo_itconenew
DB_PASS=

# Robot Database
DB_BOT_HOST=
DB_BOT_NAME=itcindo_itcrobot
DB_BOT_USER=itcindo_itcrobot
DB_BOT_PASS=

# Runitc Database
DB_RUN_HOST=
DB_RUN_NAME=itcindo_runitc
DB_RUN_USER=itcindo_runitc
DB_RUN_PASS=

# Warmesin Database
DB_WAR_HOST=
DB_WAR_NAME=warmesin_t0e1c
DB_WAR_USER=warmesin_Te5t3
DB_WAR_PASS=

# FTP Configuration
FTP_HOST=
FTP_PUBLIC_BASE_URL=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_PATH=/
FTP_SSL=false
FTP_TIMEOUT=180
FTP_UPLOAD_TIMEOUT=55

# Participant Photo FTP Configuration
PARTICIPANT_PHOTO_FTP_HOST=
PARTICIPANT_PHOTO_FTP_USER=
PARTICIPANT_PHOTO_FTP_PASS=
PARTICIPANT_PHOTO_FTP_PORT=21
PARTICIPANT_PHOTO_FTP_PATH=
PARTICIPANT_PHOTO_FTP_SSL=false
PARTICIPANT_PHOTO_FTP_TIMEOUT=30
PARTICIPANT_PHOTO_FTP_PASSIVE_MODE=true
PARTICIPANT_PHOTO_FTP_AUTO_DETECT_MODE=false

# Filing System
FILING_TRASH_RETENTION_DAYS=30
FILING_HTTP_UPLOAD_ENABLED=false
FILING_HTTP_UPLOAD_URL=
FILING_HTTP_UPLOAD_TOKEN=
FILING_HTTP_UPLOAD_TIMEOUT=30

# Gunakan tabel baru (file_system, file_shareto, sysitc_serialno, sys_msttable).
# Set true untuk mengaktifkan; false untuk kembali ke tabel lama (sys_filing*).
FILING_USE_NEW_TABLES=false

# Base URL publik untuk download cepat file filing (server storage fsys).
# File baru disimpan di bawah /filesys/... pada docroot fsys.
FILING_PUBLIC_BASE_URL=

# Set only on the HTTP upload receiver/storage server.
# Example: 
FILING_HTTP_UPLOAD_STORAGE_ROOT=

# CRC Collector Database
# Used by TEST DOCUMENT > CRC B2 Offline to read collector queue/status.
DB_COLLECTOR_HOST=
DB_COLLECTOR_PORT=3306
DB_COLLECTOR_NAME=
DB_COLLECTOR_USER=
DB_COLLECTOR_PASS=

# CRC Collector Receiver
# Receiver PHP should be placed on a publicly reachable path that can read collector/final.
CRC_B2_RECEIVER_URL=
CRC_B2_RECEIVER_TOKEN=
CRC_B2_STORAGE_ROOT=
CRC_B2_FTP_PATH=c


