<?xml version="1.0" encoding="UTF-8"?>
<!--
  Konfigurasi khusus smoke test migrasi (Fase 0).

  Berbeda dari phpunit.xml: TIDAK meng-override DB_CONNECTION/DB_DATABASE.
  Alasannya, phpunit.xml menyetel DB_DATABASE=":memory:" yang membuat koneksi
  'mysql' di config/database.php ikut menunjuk ke ":memory:" karena
  konfigurasinya membaca env('DB_DATABASE', env('DB_NAME')).

  Smoke test butuh skema legacy asli (sysitc_*, sys_menus, file_system),
  yang tidak ada di database/migrations. Setiap test dibungkus transaksi
  dan di-rollback lewat tests/Concerns/UsesLegacyDatabase.php.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         stopOnError="false"
         stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
